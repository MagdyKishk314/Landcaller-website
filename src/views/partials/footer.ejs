<%
const onHome = (typeof isHome === 'undefined') ? true : isHome;
const resolve = (h) => h.charAt(0) === '#' ? (onHome ? h : '/' + (h === '#' ? '' : h)) : h;
%>
<footer class="bg-[#0E0E0E] text-white border-t border-white/5">
  <div class="container py-14 lg:py-16">
    <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-10">
      <div class="max-w-xs">
        <a href="<%= resolve('#') %>" class="inline-block mb-4">
          <img alt="Land Caller - cold calling lead generation for land investors" class="h-9 w-auto" width="586" height="244" src="<%= site.logo %>">
        </a>
        <p class="text-sm text-white/40 leading-relaxed">The enterprise-grade cold calling system purpose-built for land investors.</p>
      </div>
      <div>
        <h4 class="text-sm font-bold text-white mb-4">Helpful Links</h4>
        <nav class="space-y-2.5">
          <% footerLinks.forEach(function(link){ %>
          <a href="<%= resolve(link.href) %>" class="block text-sm text-white/50 hover:text-white transition-colors"><%= link.label %></a>
          <% }); %>
        </nav>
      </div>
      <div>
        <h4 class="text-sm font-bold text-white mb-4">Let's Connect</h4>
        <a href="mailto:support@landcaller.com" class="inline-block text-sm text-white/50 hover:text-white transition-colors mb-4">support@landcaller.com</a>
        <div class="flex gap-3">
          <a href="<%= site.externalLinks.facebook %>" target="_blank" rel="noopener noreferrer" class="w-9 h-9 rounded-lg bg-white/5 flex items-center justify-center hover:bg-white/10 transition-colors" aria-label="Land Caller on Facebook">
            <svg class="w-4 h-4 fill-white/60" viewBox="0 0 24 24">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"></path>
            </svg>
          </a>
          <a href="<%= site.externalLinks.twitter %>" target="_blank" rel="noopener noreferrer" class="w-9 h-9 rounded-lg bg-white/5 flex items-center justify-center hover:bg-white/10 transition-colors" aria-label="Land Caller on X">
            <svg class="w-4 h-4 fill-white/60" viewBox="0 0 24 24">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
  <div class="border-t border-white/5">
    <div class="container py-5 flex flex-col sm:flex-row items-center justify-between gap-3">
      <p class="text-xs text-white/30">&copy; <%= year %> Land Caller. All rights reserved.</p>
      <div class="flex gap-4">
        <a href="<%= resolve('#') %>" class="text-xs text-white/30 hover:text-white/60 transition-colors">Privacy Policy</a>
        <a href="<%= resolve('#') %>" class="text-xs text-white/30 hover:text-white/60 transition-colors">Terms of Use</a>
        <a href="/admin" rel="nofollow" class="text-xs text-white/30 hover:text-white/60 transition-colors">Admin</a>
      </div>
    </div>
  </div>
</footer>
