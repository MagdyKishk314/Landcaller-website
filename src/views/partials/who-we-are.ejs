<section id="about" class="py-24 lg:py-32 bg-[#111111] overflow-hidden">
  <div class="container">
    <div class="grid lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      <div class="lg:col-span-7 space-y-6">
        <p class="text-[#E8523A] text-sm font-semibold tracking-wide uppercase"><%= guide.eyebrow %></p>
        <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl text-white leading-tight"><%= guide.heading %></h2>
        <% guide.body.forEach(function(paragraph){ %>
        <p class="text-white/60 leading-relaxed text-lg"><%= paragraph %></p>
        <% }); %>
        <ul class="space-y-3 pt-1">
          <% guide.highlights.forEach(function(h){ %>
          <li class="flex items-center gap-3">
            <span class="w-8 h-8 rounded-lg bg-[#E8523A]/10 flex items-center justify-center shrink-0">
              <%- include('_icons', { name: h.icon, cls: 'h-4 w-4 text-[#E8523A]' }) %>
            </span>
            <span class="text-sm text-white/80 font-medium"><%= h.label %></span>
          </li>
          <% }); %>
        </ul>
        <div class="pt-3">
          <%- include('_button', { label: guide.cta.label, href: guide.cta.href, variant: 'outline', icon: 'arrow-right' }) %>
        </div>
      </div>
      <div class="lg:col-span-5">
        <div class="relative max-w-sm mx-auto">
          <div class="rounded-2xl overflow-hidden border border-white/10 bg-[#141414]">
            <img src="/assets/images/team/joe-roberts.jpg" alt="Joe Roberts, founder of Land Caller and land investor" class="w-full h-auto object-cover" loading="lazy" width="400" height="400">
            <div class="p-5 border-t border-white/10">
              <div class="font-semibold text-white text-sm">Joe Roberts</div>
              <div class="text-[#E8523A]/70 text-xs mt-0.5">Founder &amp; land investor, USMC veteran</div>
            </div>
          </div>
          <div class="absolute -inset-4 bg-[#E8523A]/5 rounded-2xl blur-3xl -z-10"></div>
        </div>
      </div>
    </div>
  </div>
</section>
