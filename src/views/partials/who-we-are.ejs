<section id="about" class="py-24 lg:py-32 bg-[#0D0D0D] relative overflow-hidden">
  <div class="container relative z-10">
    <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl text-white text-center mb-14">Who We Are</h2>
    <div class="grid md:grid-cols-3 gap-6 lg:gap-8 max-w-5xl mx-auto">
      <% whoWeAre.forEach(function(card){ %>
      <div class="group <%= card.highlighted ? 'bg-[#E8523A]/10' : 'bg-[#141414]' %> rounded-xl p-7 border <%= card.highlighted ? 'border-[#E8523A]/20 hover:border-[#E8523A]/40' : 'border-white/5 hover:border-[#E8523A]/30' %> transition-all duration-300 hover:translate-y-[-2px] flex flex-col">
        <div class="w-12 h-12 rounded-lg <%= card.highlighted ? 'bg-[#E8523A]/20 group-hover:bg-[#E8523A]/30' : 'bg-[#E8523A]/10 group-hover:bg-[#E8523A]/20' %> flex items-center justify-center shrink-0 transition-colors mb-4">
          <%- include('_icons', { name: card.icon, cls: 'h-5 w-5 text-[#E8523A]' }) %>
        </div>
        <h3 class="text-lg font-semibold text-white mb-2"><%= card.title %></h3>
        <p class="text-sm <%= card.highlighted ? 'text-white/70 leading-relaxed mb-5' : 'text-white/60 leading-relaxed' %>"><%= card.body %></p>
        <% if (card.cta) { %>
        <a href="<%= card.cta.href %>" target="_blank" rel="noopener noreferrer" data-slot="button" class="inline-flex items-center justify-center whitespace-nowrap text-sm disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg:not([class*='size-'])]:size-4 shrink-0 [&_svg]:shrink-0 outline-none focus-visible:border-ring focus-visible:ring-ring/50 focus-visible:ring-[3px] aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 aria-invalid:border-destructive h-8 gap-1.5 px-3 has-[>svg]:px-2.5 bg-[#E8523A] hover:bg-[#E8523A]/90 text-white font-semibold mt-auto w-fit rounded-lg transition-all duration-200 active:scale-[0.97]"><%= card.cta.label %></a>
        <% } %>
      </div>
      <% }); %>
    </div>
  </div>
</section>
