<section id="packages" class="py-24 lg:py-32 bg-[#111111] border-y border-white/5">
  <div class="container">
    <div class="text-center max-w-2xl mx-auto mb-14">
      <p class="text-[#E8523A] text-sm font-semibold tracking-wide uppercase mb-4">Pricing</p>
      <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl text-white mb-4 leading-tight">Choose your weapon. Scale at your pace.</h2>
      <p class="text-white/60 leading-relaxed text-lg">Two ways to start - a dedicated full-time caller with Enterprise, or a guaranteed-lead Basic package to test the waters.</p>
    </div>
    <div class="grid lg:grid-cols-2 gap-8 max-w-5xl mx-auto">
      <% [{ plan: enterprise, pop: true, icon: 'crown' }, { plan: basic, pop: false, icon: 'zap' }].forEach(function(x){ const p = x.plan; const pop = x.pop; %>
      <div class="<%= pop ? 'relative bg-[#141414] rounded-xl border-2 border-[#E8523A] p-7 lg:p-8' : 'bg-[#141414] rounded-xl border border-white/10 p-7 lg:p-8' %> flex flex-col">
        <% if (pop) { %>
        <div class="absolute -top-3 left-8 bg-[#E8523A] text-white text-xs font-bold px-4 py-1.5 rounded-full uppercase tracking-wider">Most Popular</div>
        <% } %>
        <div class="flex items-center gap-3 mb-1">
          <div class="w-10 h-10 rounded-lg <%= pop ? 'bg-[#E8523A]/10' : 'bg-white/5' %> flex items-center justify-center">
            <%- include('_icons', { name: x.icon, cls: pop ? 'h-5 w-5 text-[#E8523A]' : 'h-5 w-5 text-white/70' }) %>
          </div>
          <div>
            <h3 class="text-xl font-bold text-white"><%= p.name %></h3>
            <p class="text-xs text-white/50"><%= p.tagline %></p>
          </div>
        </div>
        <div class="flex items-end gap-1.5 mt-5 mb-6">
          <span class="text-xs text-white/45 mb-1.5">from</span>
          <span class="font-display text-4xl text-white font-bold"><%= p.startingAt.price %></span>
          <% if (p.startingAt.per) { %><span class="text-white/45 text-sm mb-1.5"><%= p.startingAt.per %></span><% } %>
        </div>
        <ul class="space-y-2.5 mb-6">
          <% p.features.slice(0, 4).forEach(function(f){ %>
          <li class="flex items-start gap-2 text-sm text-white/70"><%- include('_icons', { name: 'check', cls: 'h-4 w-4 text-[#E8523A] mt-0.5 shrink-0' }) %><%= f.label %></li>
          <% }); %>
        </ul>
        <%- include('_button', { label: 'See ' + p.name + ' pricing', href: '/pricing', variant: pop ? 'primary' : 'outline', icon: 'arrow-right', block: true, extra: 'mt-auto' }) %>
      </div>
      <% }); %>
    </div>
    <div class="text-center mt-10">
      <%- include('_section-link', { label: 'Compare full pricing & features', href: '/pricing' }) %>
    </div>
  </div>
</section>
