<section class="py-24 lg:py-32 bg-[#0E0E0E]">
  <div class="container">
    <div class="text-center max-w-2xl mx-auto mb-16">
      <p class="text-[#E8523A] text-sm font-semibold tracking-wide uppercase mb-4"><%= howItWorks.eyebrow %></p>
      <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl text-white mb-4 leading-tight"><%= howItWorks.heading %></h2>
      <p class="text-white/60 leading-relaxed text-lg"><%= howItWorks.subtext %></p>
    </div>

    <ol class="lc-timeline" data-timeline>
      <span class="lc-timeline__rail" data-timeline-rail aria-hidden="true">
        <span class="lc-timeline__progress" data-timeline-progress></span>
      </span>
      <% howItWorks.steps.forEach(function(step){ const stepCrm = /CRM/.test(step.title); %>
      <li class="lc-timeline__item" data-timeline-item>
        <div class="lc-timeline__node" data-timeline-node aria-hidden="true"><%= step.number %></div>
        <div class="lc-timeline__content">
          <h3 class="lc-timeline__title"><%= step.title %><% if (stepCrm) { %><%- include('_coming-soon-badge') %><% } %></h3>
          <ul class="lc-timeline__points">
            <% step.points.forEach(function(point){ %>
            <li class="lc-timeline__point">
              <%- include('_icons', { name: 'check', cls: 'lc-timeline__check' }) %>
              <span><%= point %></span>
            </li>
            <% }); %>
          </ul>
          <% if (stepCrm && typeof crmDisclosure !== 'undefined') { %>
          <p class="text-xs text-white/45 leading-relaxed" style="margin-top:0.85rem;"><span style="color:#E8523A;font-weight:600;">Note:</span> <%= crmDisclosure %></p>
          <% } %>
        </div>
      </li>
      <% }); %>
    </ol>

    <div class="flex flex-wrap items-center justify-center gap-5 mt-12">
      <%- include('_button', { label: 'Book A Call', href: '#book', variant: 'primary' }) %>
    </div>
  </div>
</section>
