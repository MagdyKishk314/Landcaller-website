<section id="faq" class="py-24 lg:py-32 bg-[#0E0E0E] overflow-hidden">
  <div class="container">
    <div class="grid lg:grid-cols-[1fr_2fr] gap-12 lg:gap-16">
      <div>
        <h2 class="font-display text-3xl sm:text-4xl text-white mb-4">Got Questions?</h2>
        <p class="text-white/50 leading-relaxed">Everything you need to know about Land Caller - straight answers, no fluff.</p>
        <div class="w-12 h-0.5 bg-[#E8523A] mt-6"></div>
      </div>
      <div>
        <div data-slot="accordion" class="space-y-3" data-orientation="vertical" data-faq>
          <% faqs.forEach(function(f, i){ %>
          <div data-state="closed" data-orientation="vertical" data-slot="accordion-item" class="last:border-b-0 bg-[#141414] border border-white/5 rounded-lg px-6 data-[state=open]:border-[#E8523A]/30 transition-all" data-faq-item>
            <h3 data-orientation="vertical" data-state="closed" class="flex">
              <button type="button" aria-controls="faq-content-<%= i %>" aria-expanded="false" data-state="closed" data-orientation="vertical" id="faq-trigger-<%= i %>" data-slot="accordion-trigger" class="focus-visible:border-ring focus-visible:ring-ring/50 flex flex-1 items-start justify-between gap-4 rounded-md transition-all outline-none hover:underline focus-visible:ring-[3px] disabled:pointer-events-none disabled:opacity-50 [&[data-state=open]>svg]:rotate-180 text-left text-sm font-semibold text-white/90 hover:text-[#E8523A] py-5 [&[data-state=open]]:text-[#E8523A]" data-faq-trigger><%= f.question %><%- include('_icons', { name: 'chevron-down', cls: 'text-muted-foreground pointer-events-none size-4 shrink-0 translate-y-0.5 transition-transform duration-200' }) %></button>
            </h3>
            <div data-state="closed" id="faq-content-<%= i %>" hidden role="region" aria-labelledby="faq-trigger-<%= i %>" data-orientation="vertical" data-slot="accordion-content" class="data-[state=closed]:animate-accordion-up data-[state=open]:animate-accordion-down overflow-hidden text-sm" data-faq-panel style="--radix-accordion-content-height: var(--radix-collapsible-content-height); --radix-accordion-content-width: var(--radix-collapsible-content-width);">
              <div class="pt-0 pb-4 text-sm text-white/60 leading-relaxed pb-5"><%= f.answer %></div>
            </div>
          </div>
          <% }); %>
        </div>
        <div class="mt-8">
          <%- include('_button', { label: 'Still have questions? Book a call', href: '#book', variant: 'outline' }) %>
        </div>
      </div>
    </div>
  </div>
</section>
