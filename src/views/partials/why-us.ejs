<section class="py-24 lg:py-32 bg-[#0E0E0E]">
  <div class="container">
    <div class="text-center max-w-2xl mx-auto mb-14">
      <p class="text-[#E8523A] text-sm font-semibold tracking-wide uppercase mb-4">Why Land Caller</p>
      <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl text-white mb-4 leading-tight">Why Land Caller Wins</h2>
      <p class="text-white/60 leading-relaxed text-lg">The first and only cold calling team built exclusively for vacant land - and it shows in every dial.</p>
    </div>

    <!-- Top differentiators -->
    <div class="grid md:grid-cols-3 gap-x-12 lg:gap-x-20 gap-y-10 max-w-5xl mx-auto mb-16">
      <% whatSetsApart.items.slice(0, 3).forEach(function(item){ %>
      <div class="group flex items-start gap-4 border-l-2 border-[#E8523A]/40 pl-6 hover:border-[#E8523A] transition-colors duration-300">
        <span class="font-display text-3xl text-[#E8523A]/60 group-hover:text-[#E8523A] transition-colors shrink-0 leading-none"><%= item.number %></span>
        <div>
          <h3 class="text-base font-semibold text-white mb-1.5"><%= item.title %></h3>
          <p class="text-sm text-white/50 leading-relaxed"><%= item.body %></p>
        </div>
      </div>
      <% }); %>
    </div>

    <!-- Condensed "us vs everyone else" comparison -->
    <div class="overflow-x-auto rounded-xl border border-white/10 bg-[#111111] shadow-lg shadow-black/20 max-w-4xl mx-auto">
      <div class="min-w-[600px]">
        <div class="grid grid-cols-[1fr_1fr_1fr] border-b border-white/10">
          <div class="p-4 lg:p-5 flex items-center"><span class="text-[#E8523A] font-bold text-sm">How we compare</span></div>
          <div class="p-4 lg:p-5 text-center bg-[#E8523A]/10 border-x border-white/5">
            <span class="font-semibold text-[#E8523A] text-sm">Land Caller</span>
          </div>
          <div class="p-4 lg:p-5 text-center"><span class="text-sm font-medium text-white/40">Everyone Else</span></div>
        </div>
        <% comparisonRows.forEach(function(row, idx){ const last = idx === comparisonRows.length - 1; %>
        <div class="grid grid-cols-[1fr_1fr_1fr] <%= last ? '' : 'border-b border-white/5' %>">
          <div class="p-4 lg:p-5 flex items-center"><span class="text-sm text-white/70 font-medium"><%= row.feature %></span></div>
          <div class="p-4 lg:p-5 bg-[#E8523A]/5 border-x border-white/5 flex items-center">
            <div class="flex items-start gap-2">
              <div class="w-5 h-5 rounded-full bg-[#E8523A]/20 flex items-center justify-center shrink-0 mt-0.5"><%- include('_icons', { name: 'check', cls: 'h-3 w-3 text-[#E8523A]' }) %></div>
              <span class="text-sm font-medium text-[#E8523A]"><%= row.landCaller %></span>
            </div>
          </div>
          <div class="p-4 lg:p-5 flex items-center">
            <div class="flex items-start gap-2">
              <div class="w-5 h-5 rounded-full bg-white/5 flex items-center justify-center shrink-0 mt-0.5"><%- include('_icons', { name: 'x', cls: 'h-3 w-3 text-white/30' }) %></div>
              <span class="text-sm text-white/40"><%= row.everyoneElse %></span>
            </div>
          </div>
        </div>
        <% }); %>
      </div>
    </div>
    <div class="flex flex-wrap items-center justify-center gap-5 mt-10">
      <%- include('_button', { label: 'Book A Call', href: '#book', variant: 'primary' }) %>
    </div>
  </div>
</section>
