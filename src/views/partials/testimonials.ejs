<section class="py-24 lg:py-32 bg-[#111111] border-y border-white/5 overflow-hidden">
  <div class="container">
    <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl text-white text-center mb-4">Don't Take Our Word For It</h2>
    <p class="text-white/50 text-center mb-14 text-lg">Hear from investors already winning with Land Caller.</p>
    <div class="grid md:grid-cols-3 gap-6 lg:gap-8">
      <% testimonials.forEach(function(t){ %>
      <div class="flex flex-col bg-[#141414] border border-white/5 rounded-xl p-8 hover:border-[#E8523A]/40 hover:bg-[#1A1A1A] transition-all duration-300">
        <%- include('_icons', { name: 'quote', cls: 'h-8 w-8 text-[#E8523A]/30 mb-4' }) %>
        <div class="flex gap-0.5 mb-5">
          <% for (let i = 0; i < t.rating; i++) { %><%- include('_icons', { name: 'star', cls: 'h-3.5 w-3.5 fill-[#E8523A] text-[#E8523A]' }) %><% } %>
        </div>
        <p class="text-white/70 text-sm leading-relaxed mb-8"><%= t.quote %></p>
        <div class="mt-auto border-t border-white/10 pt-4">
          <div class="font-semibold text-white text-sm"><%= t.name %></div>
          <div class="text-[#E8523A]/70 text-xs mt-0.5"><%= t.company %></div>
        </div>
      </div>
      <% }); %>
    </div>
    <div class="text-center mt-10">
      <%- include('_button', { label: 'Join them - Book A Call', href: '#book', variant: 'outline' }) %>
    </div>
  </div>
</section>
