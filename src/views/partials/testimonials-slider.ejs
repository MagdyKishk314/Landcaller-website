<section class="py-20 lg:py-24 bg-[#111111] border-b border-white/5">
  <div class="container">
    <div class="text-center max-w-2xl mx-auto mb-12">
      <p class="text-[#E8523A] text-sm font-semibold tracking-wide uppercase mb-4">Testimonials</p>
      <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl text-white mb-4 leading-tight">We proved that we can do it.</h2>
      <p class="text-white/60 leading-relaxed text-lg">Hear from land investors already winning with Land Caller.</p>
    </div>

    <div class="lc-slider max-w-6xl mx-auto" data-slider aria-roledescription="carousel" aria-label="Client testimonials">
      <button type="button" class="lc-slider__btn lc-slider__btn--prev" data-slider-prev aria-label="Previous testimonials"><%- include('_icons', { name: 'arrow-right', cls: 'h-5 w-5 rotate-180' }) %></button>
      <div class="lc-slider__viewport">
        <div class="lc-slider__track" data-slider-track>
          <% testimonials.forEach(function(t, i){
               const initials = t.name.split(/\s+/).map(function(w){ return w[0]; }).join('').slice(0, 2).toUpperCase(); %>
          <div class="lc-slider__slide" data-slider-slide role="group" aria-roledescription="slide" aria-label="Testimonial <%= i + 1 %> of <%= testimonials.length %>">
            <figure class="bg-[#141414] border border-white/10 rounded-xl p-6 h-full flex flex-col hover:border-[#E8523A]/40 transition-colors duration-300">
              <div class="flex gap-0.5 mb-4">
                <% for (let s = 0; s < t.rating; s++) { %><%- include('_icons', { name: 'star', cls: 'h-3.5 w-3.5 fill-[#E8523A] text-[#E8523A]' }) %><% } %>
              </div>
              <blockquote class="text-white/75 text-sm leading-relaxed flex-1">"<%= t.quote %>"</blockquote>
              <figcaption class="flex items-center gap-3 mt-6 pt-4 border-t border-white/10">
                <div class="w-11 h-11 rounded-full bg-[#E8523A]/15 text-[#E8523A] font-bold text-sm flex items-center justify-center shrink-0"><%= initials %></div>
                <div>
                  <div class="font-semibold text-white text-sm"><%= t.name %></div>
                  <div class="text-[#E8523A]/80 text-xs mt-0.5"><%= t.company %></div>
                </div>
              </figcaption>
            </figure>
          </div>
          <% }); %>
        </div>
      </div>
      <button type="button" class="lc-slider__btn lc-slider__btn--next" data-slider-next aria-label="Next testimonials"><%- include('_icons', { name: 'arrow-right', cls: 'h-5 w-5' }) %></button>
    </div>
  </div>
</section>
