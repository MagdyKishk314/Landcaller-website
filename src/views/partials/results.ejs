<section class="py-16 lg:py-20 bg-[#0A0A0A] border-b border-white/5">
  <div class="container">
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-6 max-w-5xl mx-auto">
      <% resultsStats.forEach(function(stat){ %>
      <div class="text-center">
        <div class="font-display text-4xl lg:text-5xl text-[#E8523A] font-bold mb-2"><%= stat.value %></div>
        <div class="text-sm text-white/55 leading-snug max-w-[12rem] mx-auto"><%= stat.label %></div>
      </div>
      <% }); %>
    </div>
  </div>
</section>
