<!doctype html>
<html lang="en">

  <%- include('partials/_head') %>

  <body>
    <div id="root">
      <div class="min-h-screen flex flex-col bg-background">
        <%- include('partials/header') %>
        <main>

          <!-- Hero: title, dashboard screenshot shown at its natural resolution
               (capped at native width so it is never upscaled/blurred), copy + CTAs. -->
          <section class="bg-[#0E0E0E] border-b border-white/5 overflow-hidden" style="padding-top: clamp(2.5rem, 5vw, 4rem); padding-bottom: clamp(2.5rem, 5vw, 4rem);">
            <div class="container">
              <div class="max-w-5xl mx-auto text-center">
                <p class="text-[#E8523A] text-sm sm:text-base font-semibold tracking-wide uppercase mb-4"><%= page.eyebrow %></p>
                <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl text-white leading-[1.1] font-bold tracking-tight" style="margin-bottom: 2rem;"><%= page.h1 %></h1>
                <div class="rounded-xl border border-white/10 bg-[#111111] shadow-2xl shadow-black/40 overflow-hidden mx-auto" style="max-width: 1024px;">
                  <img src="<%= page.image %>" alt="Land Caller Data Dashboard showing property market insights, owner counts, and sales analytics" title="Land Caller Data Dashboard" class="block w-full h-auto" loading="lazy" decoding="async">
                </div>
                <p class="text-white/70 text-lg leading-relaxed max-w-3xl mx-auto" style="margin-top: 2rem; margin-bottom: 1.5rem;"><%= page.lede %></p>
                <div class="flex flex-wrap items-center justify-center gap-4">
                  <%- include('partials/_button', { label: 'Book A Call', href: '/#book', variant: 'primary', size: 'lg' }) %>
                  <%- include('partials/_button', { label: 'View Pricing', href: '/pricing', variant: 'outline', size: 'lg' }) %>
                </div>
              </div>
            </div>
          </section>

          <!-- Data dashboard: Smart Estimates -->
          <section class="py-24 lg:py-32 bg-[#111111] border-b border-white/5">
            <div class="container">
              <!-- Centered intro + stat -->
              <div class="text-center max-w-3xl mx-auto mb-12">
                <p class="text-[#E8523A] text-sm font-semibold tracking-wide uppercase mb-4"><%= dataDashboard.eyebrow %></p>
                <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl text-white mb-4 leading-tight"><%= dataDashboard.heading %></h2>
                <p class="text-white/60 leading-relaxed text-lg mb-8"><%= dataDashboard.body %></p>
                <div class="inline-flex items-center gap-4 rounded-xl border border-white/10 bg-[#0E0E0E] p-6" style="text-align:left;">
                  <span class="font-display text-4xl lg:text-5xl text-[#E8523A] font-bold leading-none"><%= dataDashboard.stat.value %></span>
                  <span class="text-sm text-white/55 leading-snug max-w-[12rem]"><%= dataDashboard.stat.label %></span>
                </div>
              </div>
              <!-- Supporting points -->
              <div class="grid sm:grid-cols-2 gap-5 max-w-4xl mx-auto">
                <% dataDashboard.points.forEach(function(p){ %>
                <div class="bg-[#141414] rounded-xl p-6 border border-white/5 hover:border-[#E8523A]/30 transition-all duration-300">
                  <div class="w-9 h-9 rounded-full bg-[#E8523A]/15 flex items-center justify-center mb-4"><%- include('partials/_icons', { name: 'check', cls: 'h-4 w-4 text-[#E8523A]' }) %></div>
                  <h3 class="text-base font-semibold text-white mb-1.5"><%= p.title %></h3>
                  <p class="text-sm text-white/50 leading-relaxed"><%= p.detail %></p>
                </div>
                <% }); %>
              </div>
            </div>
          </section>

          <!-- Lead delivery: call -> QA -> delivered -->
          <section class="py-24 lg:py-32 bg-[#0E0E0E] border-b border-white/5">
            <div class="container">
              <div class="text-center max-w-3xl mx-auto mb-14">
                <p class="text-[#E8523A] text-sm font-semibold tracking-wide uppercase mb-4"><%= dataDelivery.eyebrow %></p>
                <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl text-white mb-4 leading-tight"><%= dataDelivery.heading %></h2>
                <p class="text-white/60 leading-relaxed text-lg"><%= dataDelivery.body %></p>
              </div>

              <div class="flex flex-col md:flex-row items-stretch justify-center gap-4 max-w-5xl mx-auto">
                <% dataDelivery.flow.forEach(function(step, i){ %>
                <div class="flex-1 rounded-xl border border-white/10 bg-[#141414] p-6 text-center">
                  <div class="w-12 h-12 rounded-full bg-[#E8523A]/15 flex items-center justify-center mx-auto mb-4"><%- include('partials/_icons', { name: step.icon, cls: 'h-5 w-5 text-[#E8523A]' }) %></div>
                  <h3 class="text-base font-semibold text-white mb-1.5"><%= step.title %></h3>
                  <p class="text-sm text-white/50 leading-relaxed"><%= step.detail %></p>
                </div>
                <% if (i < dataDelivery.flow.length - 1) { %>
                <div class="hidden md:flex items-center justify-center shrink-0 text-[#E8523A]"><%- include('partials/_icons', { name: 'arrow-right', cls: 'h-5 w-5' }) %></div>
                <% } %>
                <% }); %>
              </div>
            </div>
          </section>

          <!-- Undeniable performance: managed agents + QA -->
          <section class="py-24 lg:py-32 bg-[#111111] border-b border-white/5">
            <div class="container">
              <div class="text-center max-w-3xl mx-auto mb-14">
                <p class="text-[#E8523A] text-sm font-semibold tracking-wide uppercase mb-4"><%= dataPerformance.eyebrow %></p>
                <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl text-white mb-4 leading-tight"><%= dataPerformance.heading %></h2>
                <p class="text-white/60 leading-relaxed text-lg"><%= dataPerformance.body %></p>
              </div>
              <div class="grid md:grid-cols-2 gap-x-12 lg:gap-x-20 gap-y-10 max-w-5xl mx-auto">
                <% dataPerformance.points.forEach(function(p){ %>
                <div class="flex items-start gap-4 border-l-2 border-[#E8523A]/40 pl-6">
                  <div class="w-5 h-5 rounded-full bg-[#E8523A]/20 flex items-center justify-center shrink-0 mt-1"><%- include('partials/_icons', { name: 'check', cls: 'h-3 w-3 text-[#E8523A]' }) %></div>
                  <div>
                    <h3 class="text-base font-semibold text-white mb-1.5"><%= p.title %></h3>
                    <p class="text-sm text-white/50 leading-relaxed"><%= p.detail %></p>
                  </div>
                </div>
                <% }); %>
              </div>
            </div>
          </section>

          <!-- Closing CTA -->
          <section class="py-24 lg:py-32 bg-[#0E0E0E]">
            <div class="container max-w-3xl text-center">
              <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl text-white mb-5 leading-tight"><%= dataCta.heading %></h2>
              <p class="text-white/60 leading-relaxed text-lg mb-8"><%= dataCta.body %></p>
              <div class="flex flex-wrap items-center justify-center gap-4">
                <%- include('partials/_button', { label: 'Book A Call', href: '/#book', variant: 'primary', size: 'lg' }) %>
                <%- include('partials/_button', { label: 'View Pricing', href: '/pricing', variant: 'outline', size: 'lg' }) %>
              </div>
            </div>
          </section>

        </main>
        <%- include('partials/footer') %>
      </div>
    </div>
    <div id="toast-region" class="lc-toaster" aria-live="polite" aria-atomic="false"></div>
  </body>

</html>
