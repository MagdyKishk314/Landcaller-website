<!doctype html>
<html lang="en">

  <%- include('partials/_head') %>

  <body>
    <div id="root">
      <div class="min-h-screen flex flex-col bg-background">
        <%- include('partials/header') %>
        <main>
          <!-- Hero banner: background image + dark overlay + centered text -->
          <section class="relative border-b border-white/5 overflow-hidden bg-[#0E0E0E] flex items-center" style="min-height:clamp(440px,68vh,720px);">
            <div class="absolute inset-0 lc-banner-fixed" style="background-image:url('/assets/images/about-banner.jpg');background-size:cover;background-position:center;" role="img" aria-label="Aerial view of a vacant land parcel outlined with a boundary and marked by a location pin"></div>
            <div class="absolute inset-0" style="background:linear-gradient(to bottom, rgba(14,14,14,0.6), rgba(14,14,14,0.45) 45%, rgba(14,14,14,0.85));"></div>
            <div class="container relative z-10 py-20 max-w-4xl text-center" style="text-shadow:0 2px 16px rgba(0,0,0,0.5);">
              <p class="text-[#E8523A] text-sm sm:text-base font-semibold tracking-wide uppercase mb-4"><%= about.eyebrow %></p>
              <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl text-white leading-[1.1] font-bold tracking-tight mb-6"><%= about.heading %></h1>
              <p class="text-white/85 text-lg leading-relaxed max-w-2xl mx-auto"><%= about.lede %></p>
            </div>
          </section>

          <!-- Who We Are -->
          <section class="py-24 lg:py-32 bg-[#0D0D0D] border-b border-white/5">
            <div class="container">
              <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl text-white text-center mb-12"><%= about.storyHeading %></h2>
              <div class="max-w-3xl mx-auto space-y-6">
                <% about.story.forEach(function(paragraph){ %>
                <p class="text-white/70 leading-relaxed text-lg"><%- paragraph %></p>
                <% }); %>
              </div>
            </div>
          </section>

          <!-- CTA -->
          <section class="py-24 lg:py-32 bg-[#0E0E0E]">
            <div class="container max-w-3xl text-center">
              <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl text-white mb-8 leading-tight"><%= about.ctaHeading %></h2>
              <%- include('partials/_button', { label: 'Book A Call', href: site.externalLinks.bookACall, variant: 'primary', size: 'lg', external: true }) %>
            </div>
          </section>
        </main>
        <%- include('partials/footer') %>
      </div>
    </div>
    <div id="toast-region" class="lc-toaster" aria-live="polite" aria-atomic="false"></div>
  </body>

</html>
