<!doctype html>
<html lang="en">

  <%- include('partials/_head') %>

  <body>
    <div id="root">
      <div class="min-h-screen flex flex-col bg-background">
        <%- include('partials/header') %>
        <main>
          <article>
            <!-- Header -->
            <section class="py-20 lg:py-28 bg-[#0A0A0A] border-b border-white/5">
              <div class="container max-w-3xl">
                <a href="/blog" class="inline-flex items-center gap-1.5 text-sm font-medium text-white/50 hover:text-[#E8523A] transition-colors mb-8"><%- include('partials/_icons', { name: 'arrow-right', cls: 'h-4 w-4 rotate-180' }) %> Back to blog</a>
                <div class="flex items-center gap-3 mb-5">
                  <span class="text-[10px] font-bold uppercase tracking-wider text-[#E8523A] bg-[#E8523A]/10 px-2.5 py-1 rounded-full"><%= post.category %></span>
                  <span class="text-xs text-white/40"><%= new Date(post.date).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }) %> &middot; <%= post.readingTime %></span>
                </div>
                <h1 class="font-display text-3xl sm:text-4xl lg:text-5xl text-white leading-[1.1] font-bold tracking-tight mb-6"><%= post.title %></h1>
                <p class="text-white/70 text-lg leading-relaxed"><%= post.excerpt %></p>
              </div>
            </section>

            <!-- Body (placeholder until real content lands) -->
            <section class="py-16 lg:py-24 bg-[#0D0D0D]">
              <div class="container max-w-3xl">
                <div class="aspect-video overflow-hidden rounded-xl bg-[#0A0A0A] border border-white/5 mb-10">
                  <img src="<%= post.image %>" alt="<%= post.title %>" class="w-full h-full object-cover" loading="lazy">
                </div>
                <div class="space-y-6 text-white/60 leading-relaxed text-lg">
                  <p>This article is on the way. Our team is putting the finishing touches on it - check back soon for the full breakdown.</p>
                  <p>In the meantime, the fastest way to get answers specific to your markets is to talk to us directly. Book a free strategy call and we'll walk you through exactly how cold calling can fit your land acquisition pipeline.</p>
                </div>
              </div>
            </section>

            <!-- CTA -->
            <section class="py-20 lg:py-28 bg-[#0A0A0A] border-t border-white/5">
              <div class="container max-w-3xl text-center">
                <h2 class="font-display text-2xl sm:text-3xl lg:text-4xl text-white mb-5 leading-tight">Want leads, not just reading?</h2>
                <p class="text-white/60 leading-relaxed text-lg mb-8">Book a call and we'll build the campaign for you.</p>
                <%- include('partials/_button', { label: 'Book A Call', href: site.externalLinks.bookACall, variant: 'primary', size: 'lg', external: true }) %>
              </div>
            </section>
          </article>
        </main>
        <%- include('partials/footer') %>
      </div>
    </div>
    <div id="toast-region" class="lc-toaster" aria-live="polite" aria-atomic="false"></div>
  </body>

</html>
