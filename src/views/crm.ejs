<!doctype html>
<html lang="en">

  <%- include('partials/_head') %>

  <body>
    <div id="root">
      <div class="min-h-screen flex flex-col bg-background">
        <%- include('partials/header') %>
        <main>

          <!-- Hero: copy + CRM dashboard preview -->
          <section class="py-24 lg:py-32 bg-[#0E0E0E] border-b border-white/5 overflow-hidden">
            <div class="container">
              <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center max-w-6xl mx-auto">
                <div>
                  <p class="text-[#E8523A] text-sm sm:text-base font-semibold tracking-wide uppercase mb-4"><%= page.eyebrow %></p>
                  <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl text-white leading-[1.1] font-bold tracking-tight mb-6"><%= page.h1 %></h1>
                  <p class="text-white/70 text-lg leading-relaxed mb-6"><%= page.lede %></p>
                  <p class="text-white font-semibold text-lg mb-8"><%= page.tagline %></p>
                  <div class="flex flex-wrap items-center gap-4">
                    <%- include('partials/_button', { label: 'Book A Call', href: '/#book', variant: 'primary', size: 'lg' }) %>
                    <%- include('partials/_button', { label: 'View Pricing', href: '/pricing', variant: 'outline', size: 'lg' }) %>
                  </div>
                </div>

                <!-- Decorative product preview of the Land Caller CRM dashboard -->
                <div class="relative" aria-hidden="true">
                  <div class="rounded-xl border border-white/10 bg-[#111111] shadow-lg shadow-black/20 overflow-hidden">
                    <div class="flex items-center gap-2 px-4 py-3 border-b border-white/10 bg-[#0E0E0E]">
                      <span class="rounded-full bg-white/15" style="width:10px;height:10px;"></span>
                      <span class="rounded-full bg-white/15" style="width:10px;height:10px;"></span>
                      <span class="rounded-full bg-white/15" style="width:10px;height:10px;"></span>
                      <span class="text-white/40 text-xs" style="margin-left:8px;">Land Caller CRM &mdash; Dashboard</span>
                    </div>
                    <div class="p-5">
                      <div class="grid grid-cols-2 gap-3 mb-5">
                        <% [
                             { label: 'Leads this month', value: '312', delta: '+18%' },
                             { label: 'Connect rate', value: '34%', delta: '+6 pts' },
                             { label: 'Deals in pipeline', value: '27', delta: '+4' },
                             { label: 'Cost / lead', value: '$41', delta: '-12%' }
                           ].forEach(function(k){ %>
                        <div class="rounded-lg border border-white/10 bg-[#141414] p-4">
                          <div class="text-white/40 text-xs mb-1"><%= k.label %></div>
                          <div class="font-display text-2xl text-white font-bold"><%= k.value %></div>
                          <div class="text-[#E8523A] text-xs mt-1"><%= k.delta %></div>
                        </div>
                        <% }); %>
                      </div>

                      <div class="rounded-lg border border-white/10 bg-[#141414] p-4 mb-5">
                        <div class="flex items-center justify-between mb-3">
                          <span class="text-white/60 text-xs font-medium">Calls per day</span>
                          <span class="text-[#E8523A] text-xs font-medium">This week</span>
                        </div>
                        <div class="flex items-end gap-2" style="height:78px;">
                          <% [42, 58, 50, 71, 64, 83, 76].forEach(function(h){ %>
                          <div class="flex-1 rounded-t" style="height:<%= h %>%; background:linear-gradient(to top, #E8523A, rgba(232,82,58,0.35));"></div>
                          <% }); %>
                        </div>
                      </div>

                      <div class="space-y-2">
                        <% [
                             { name: 'Marcus T.', status: 'Hot lead', tone: 'hot' },
                             { name: 'Priya N.', status: 'Follow-up', tone: 'warm' },
                             { name: 'Dale W.', status: 'Under contract', tone: 'won' }
                           ].forEach(function(row){
                               const initials = row.name.split(/\s+/).map(function(w){ return w[0]; }).join('').slice(0,2).toUpperCase();
                               const tone = row.tone === 'won'
                                 ? 'text-[#E8523A] bg-[#E8523A]/15'
                                 : row.tone === 'hot'
                                   ? 'text-white bg-white/10'
                                   : 'text-white/60 bg-white/5'; %>
                        <div class="flex items-center justify-between rounded-lg border border-white/10 bg-[#141414] px-4 py-3">
                          <div class="flex items-center gap-3">
                            <span class="rounded-full bg-[#E8523A]/15 text-[#E8523A] font-bold flex items-center justify-center shrink-0" style="width:28px;height:28px;font-size:11px;"><%= initials %></span>
                            <span class="text-white/80 text-sm"><%= row.name %></span>
                          </div>
                          <span class="text-xs font-medium rounded-full px-2.5 py-1 <%= tone %>"><%= row.status %></span>
                        </div>
                        <% }); %>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </section>

          <!-- CRM: the acquisition command center -->
          <section class="py-24 lg:py-32 bg-[#111111] border-b border-white/5">
            <div class="container">
              <div class="text-center max-w-3xl mx-auto mb-12">
                <p class="text-[#E8523A] text-sm font-semibold tracking-wide uppercase mb-3"><%= crmIntro.eyebrow %></p>
                <span class="inline-flex items-center gap-1.5 text-xs font-medium text-white/50 bg-[#0E0E0E] border border-white/10 rounded-full px-3 py-1 mb-5"><%- include('partials/_icons', { name: 'zap', cls: 'h-3.5 w-3.5 text-[#E8523A]' }) %><%= crmIntro.poweredBy %></span>
                <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl text-white mb-5 leading-tight"><%= crmIntro.heading %></h2>
                <p class="text-white/60 leading-relaxed text-lg"><%= crmIntro.body %></p>
              </div>
              <p class="text-center text-white/80 font-semibold mb-8"><%= crmIntro.featuresIntro %></p>
              <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8 max-w-6xl mx-auto">
                <% crmIntro.features.forEach(function(f){ %>
                <div class="bg-[#141414] rounded-xl p-7 border border-white/5 hover:border-[#E8523A]/30 transition-all duration-300">
                  <div class="w-11 h-11 rounded-full bg-[#E8523A]/15 flex items-center justify-center mb-5"><%- include('partials/_icons', { name: f.icon, cls: 'h-5 w-5 text-[#E8523A]' }) %></div>
                  <h3 class="text-lg font-semibold text-white mb-2"><%= f.title %></h3>
                  <p class="text-sm text-white/55 leading-relaxed"><%= f.detail %></p>
                </div>
                <% }); %>
              </div>
              <p class="text-center text-white/60 leading-relaxed text-lg max-w-3xl mx-auto mt-12"><%= crmIntro.closing %></p>
            </div>
          </section>

          <!-- Undeniable performance: managed agents + QA -->
          <section class="py-24 lg:py-32 bg-[#0E0E0E] border-b border-white/5">
            <div class="container">
              <div class="max-w-3xl mb-14">
                <p class="text-[#E8523A] text-sm font-semibold tracking-wide uppercase mb-4"><%= crmPerformance.eyebrow %></p>
                <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl text-white mb-4 leading-tight"><%= crmPerformance.heading %></h2>
                <p class="text-white/60 leading-relaxed text-lg"><%= crmPerformance.body %></p>
              </div>
              <div class="grid md:grid-cols-2 gap-x-12 lg:gap-x-20 gap-y-10 max-w-5xl mx-auto">
                <% crmPerformance.points.forEach(function(p){ %>
                <div class="flex items-start gap-4 border-l-2 border-[#E8523A]/40 pl-6">
                  <div class="w-5 h-5 rounded-full bg-[#E8523A]/20 flex items-center justify-center shrink-0 mt-1"><%- include('partials/_icons', { name: 'check', cls: 'h-3 w-3 text-[#E8523A]' }) %></div>
                  <div>
                    <h3 class="text-base font-semibold text-white mb-1.5"><%= p.title %></h3>
                    <p class="text-sm text-white/50 leading-relaxed"><%= p.detail %></p>
                  </div>
                </div>
                <% }); %>
              </div>
            </div>
          </section>

          <!-- Full integration callout -->
          <section class="py-16 lg:py-20 bg-[#111111] border-b border-white/5">
            <div class="container">
              <div class="max-w-4xl mx-auto rounded-xl border border-white/10 bg-[#141414] p-8 flex flex-col md:flex-row md:items-center gap-6">
                <div class="w-11 h-11 rounded-full bg-[#E8523A]/15 flex items-center justify-center shrink-0"><%- include('partials/_icons', { name: 'trending-up', cls: 'h-5 w-5 text-[#E8523A]' }) %></div>
                <div>
                  <p class="text-[#E8523A] text-sm font-semibold tracking-wide uppercase mb-2"><%= crmIntegration.eyebrow %></p>
                  <h2 class="text-xl font-bold text-white mb-2"><%= crmIntegration.heading %></h2>
                  <p class="text-white/60 leading-relaxed"><%= crmIntegration.body %></p>
                </div>
              </div>
            </div>
          </section>

          <!-- Data dashboard: Smart Estimates -->
          <section class="py-24 lg:py-32 bg-[#0E0E0E] border-b border-white/5">
            <div class="container">
              <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center max-w-6xl mx-auto">
                <div>
                  <p class="text-[#E8523A] text-sm font-semibold tracking-wide uppercase mb-4"><%= crmDataDashboard.eyebrow %></p>
                  <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl text-white mb-4 leading-tight"><%= crmDataDashboard.heading %></h2>
                  <p class="text-white/60 leading-relaxed text-lg mb-6"><%= crmDataDashboard.body %></p>
                  <div class="inline-flex items-center gap-4 rounded-xl border border-white/10 bg-[#111111] p-6">
                    <span class="font-display text-4xl lg:text-5xl text-[#E8523A] font-bold leading-none"><%= crmDataDashboard.stat.value %></span>
                    <span class="text-sm text-white/55 leading-snug max-w-[12rem]"><%= crmDataDashboard.stat.label %></span>
                  </div>
                </div>
                <div class="grid sm:grid-cols-2 gap-5">
                  <% crmDataDashboard.points.forEach(function(p){ %>
                  <div class="bg-[#141414] rounded-xl p-6 border border-white/5 hover:border-[#E8523A]/30 transition-all duration-300">
                    <div class="w-9 h-9 rounded-full bg-[#E8523A]/15 flex items-center justify-center mb-4"><%- include('partials/_icons', { name: 'check', cls: 'h-4 w-4 text-[#E8523A]' }) %></div>
                    <h3 class="text-base font-semibold text-white mb-1.5"><%= p.title %></h3>
                    <p class="text-sm text-white/50 leading-relaxed"><%= p.detail %></p>
                  </div>
                  <% }); %>
                </div>
              </div>
            </div>
          </section>

          <!-- Data costs: enterprise (pass-through) + basic (included) -->
          <section class="py-24 lg:py-32 bg-[#0D0D0D] border-b border-white/5">
            <div class="container">
              <div class="text-center max-w-2xl mx-auto mb-14">
                <p class="text-[#E8523A] text-sm font-semibold tracking-wide uppercase mb-4"><%= crmDataCosts.eyebrow %></p>
                <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl text-white mb-4 leading-tight"><%= crmDataCosts.heading %></h2>
                <p class="text-white/60 leading-relaxed text-lg"><%= crmDataCosts.lede %></p>
              </div>

              <div class="grid lg:grid-cols-2 gap-6 lg:gap-8 max-w-6xl mx-auto items-start">

                <!-- Enterprise data policy -->
                <div class="bg-[#141414] border border-white/10 rounded-xl p-7 lg:p-8">
                  <div class="flex items-center justify-between gap-4 mb-2">
                    <h3 class="text-xl font-bold text-white"><%= crmDataCosts.enterprise.name %></h3>
                    <span class="inline-flex items-center text-xs font-semibold uppercase tracking-wide text-white/50 bg-[#0E0E0E] border border-white/10 rounded-full px-3 py-1 shrink-0"><%= crmDataCosts.enterprise.badge %></span>
                  </div>
                  <p class="text-sm text-white/55 leading-relaxed mb-6"><%= crmDataCosts.enterprise.note %></p>

                  <div class="space-y-5">
                    <% crmDataCosts.enterprise.options.forEach(function(o){ %>
                    <div class="rounded-lg border border-white/10 bg-[#111111] p-5">
                      <div class="flex items-start gap-3 mb-4">
                        <span class="font-display text-lg text-[#E8523A]/70 font-bold leading-none shrink-0">Option <%= o.key %></span>
                        <div>
                          <h4 class="text-sm font-semibold text-white"><%= o.title %></h4>
                          <p class="text-xs text-white/45 mt-0.5"><%= o.subtitle %></p>
                        </div>
                      </div>
                      <% if (o.tiers) { %>
                      <div class="rounded-lg border border-white/10 overflow-hidden">
                        <div class="grid grid-cols-2 border-b border-white/10 bg-[#0E0E0E]">
                          <div class="px-4 py-2"><span class="text-xs font-semibold uppercase tracking-wide text-white/40">Monthly volume</span></div>
                          <div class="px-4 py-2" style="text-align:right;"><span class="text-xs font-semibold uppercase tracking-wide text-white/40">Price / record</span></div>
                        </div>
                        <% o.tiers.forEach(function(t, i){ const last = i === o.tiers.length - 1; %>
                        <div class="grid grid-cols-2 <%= last ? '' : 'border-b border-white/5' %>">
                          <div class="px-4 py-2"><span class="text-sm text-white/70"><%= t.volume %></span></div>
                          <div class="px-4 py-2" style="text-align:right;"><span class="text-sm font-semibold text-[#E8523A]"><%= t.price %></span></div>
                        </div>
                        <% }); %>
                      </div>
                      <% } else { %>
                      <div class="flex items-center gap-2">
                        <span class="font-display text-2xl text-[#E8523A] font-bold leading-none"><%= o.flat %></span>
                        <span class="text-xs text-white/45"><%= o.flatLabel %></span>
                      </div>
                      <% } %>
                    </div>
                    <% }); %>
                  </div>
                </div>

                <!-- Basic data policy -->
                <div class="bg-[#141414] border border-white/10 rounded-xl p-7 lg:p-8 flex flex-col">
                  <div class="flex items-center justify-between gap-4 mb-2">
                    <h3 class="text-xl font-bold text-white"><%= crmDataCosts.basic.name %></h3>
                    <span class="inline-flex items-center text-xs font-semibold uppercase tracking-wide text-[#E8523A] bg-[#E8523A]/10 border border-[#E8523A]/30 rounded-full px-3 py-1 shrink-0"><%= crmDataCosts.basic.badge %></span>
                  </div>
                  <p class="text-sm text-white/55 leading-relaxed mb-6"><%= crmDataCosts.basic.note %></p>

                  <div class="rounded-lg border border-[#E8523A]/30 bg-[#E8523A]/10 p-5 flex items-start gap-3">
                    <div class="w-5 h-5 rounded-full bg-[#E8523A]/20 flex items-center justify-center shrink-0 mt-0.5"><%- include('partials/_icons', { name: 'check', cls: 'h-3 w-3 text-[#E8523A]' }) %></div>
                    <p class="text-sm text-white/70 leading-relaxed">Data credits are included with your plan &mdash; no extra cost to hit your lead guarantees.</p>
                  </div>

                  <div class="mt-auto pt-8">
                    <%- include('partials/_button', { label: 'Compare plans', href: '/pricing', variant: 'outline', block: true }) %>
                  </div>
                </div>

              </div>
            </div>
          </section>

          <!-- Closing CTA -->
          <section class="py-24 lg:py-32 bg-[#0E0E0E]">
            <div class="container max-w-3xl text-center">
              <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl text-white mb-5 leading-tight"><%= crmCta.heading %></h2>
              <p class="text-white/60 leading-relaxed text-lg mb-8"><%= crmCta.body %></p>
              <div class="flex flex-wrap items-center justify-center gap-4">
                <%- include('partials/_button', { label: 'Book A Call', href: '/#book', variant: 'primary', size: 'lg' }) %>
                <%- include('partials/_button', { label: 'View Pricing', href: '/pricing', variant: 'outline', size: 'lg' }) %>
              </div>
            </div>
          </section>

        </main>
        <%- include('partials/footer') %>
      </div>
    </div>
    <div id="toast-region" class="lc-toaster" aria-live="polite" aria-atomic="false"></div>
  </body>

</html>
