<meta name="robots" content="noindex, nofollow" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<style>
  :root {
    --bg: #0d0d0d;
    --panel: #141414;
    --panel-2: #1a1a1a;
    --border: rgba(255, 255, 255, 0.08);
    --text: #f5f5f5;
    --muted: rgba(255, 255, 255, 0.55);
    --accent: #e8523a;
    --accent-dim: rgba(232, 82, 58, 0.12);
    --green: #34c759;
    --radius: 12px;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    background: var(--bg);
    color: var(--text);
    line-height: 1.5;
  }
  a { color: var(--accent); text-decoration: none; }
  a:hover { text-decoration: underline; }
  .topbar {
    display: flex; align-items: center; justify-content: space-between;
    padding: 16px 24px; border-bottom: 1px solid var(--border); background: #0e0e0e;
    position: sticky; top: 0; z-index: 10;
  }
  .topbar .brand { font-weight: 700; letter-spacing: -0.01em; }
  .topbar .brand span { color: var(--accent); }
  .topbar .actions { display: flex; align-items: center; gap: 12px; }
  .wrap { max-width: 920px; margin: 0 auto; padding: 32px 24px 64px; }
  .wrap.narrow { max-width: 460px; }
  h1.page-title { font-size: 22px; margin: 0; letter-spacing: -0.01em; }
  .row-between { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 24px; }
  .muted { color: var(--muted); }
  .panel { background: var(--panel); border: 1px solid var(--border); border-radius: var(--radius); }
  /* Buttons */
  .btn {
    display: inline-flex; align-items: center; gap: 6px; cursor: pointer;
    font-size: 14px; font-weight: 600; padding: 9px 16px; border-radius: 8px;
    border: 1px solid var(--border); background: var(--panel-2); color: var(--text);
    transition: all .15s ease; text-decoration: none;
  }
  .btn:hover { background: #242424; text-decoration: none; }
  .btn.primary { background: var(--accent); border-color: var(--accent); color: #fff; }
  .btn.primary:hover { background: #d8442d; }
  .btn.ghost { background: transparent; }
  .btn.danger { color: #ff6b5a; border-color: rgba(255,107,90,.3); }
  .btn.danger:hover { background: rgba(255,107,90,.1); }
  .btn.sm { padding: 6px 12px; font-size: 13px; }
  /* Forms */
  label { display: block; font-size: 13px; font-weight: 600; margin-bottom: 6px; color: rgba(255,255,255,.8); }
  .field { margin-bottom: 18px; }
  .hint { font-size: 12px; color: var(--muted); margin-top: 6px; }
  input[type=text], input[type=password], input[type=date], textarea, select {
    width: 100%; padding: 10px 12px; border-radius: 8px; background: #0e0e0e;
    border: 1px solid var(--border); color: var(--text); font-size: 14px;
    font-family: inherit;
  }
  input:focus, textarea:focus, select:focus { outline: none; border-color: var(--accent); }
  textarea { resize: vertical; min-height: 320px; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 13px; line-height: 1.6; }
  .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .check { display: flex; align-items: center; gap: 10px; }
  .check input { width: 18px; height: 18px; accent-color: var(--accent); }
  .check label { margin: 0; }
  /* Table / list */
  .post-row { display: flex; align-items: center; gap: 16px; padding: 16px 20px; border-bottom: 1px solid var(--border); }
  .post-row:last-child { border-bottom: none; }
  .post-main { flex: 1; min-width: 0; }
  .post-title { font-weight: 600; margin: 0 0 4px; }
  .post-meta { font-size: 12px; color: var(--muted); }
  .post-actions { display: flex; align-items: center; gap: 8px; flex-shrink: 0; }
  .badge { display: inline-block; font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; padding: 3px 8px; border-radius: 999px; }
  .badge.published { background: rgba(52,199,89,.14); color: var(--green); }
  .badge.draft { background: rgba(255,255,255,.08); color: var(--muted); }
  .badge.cat { background: var(--accent-dim); color: var(--accent); margin-left: 8px; }
  .alert { padding: 12px 16px; border-radius: 8px; font-size: 14px; margin-bottom: 20px; }
  .alert.error { background: rgba(255,107,90,.1); border: 1px solid rgba(255,107,90,.3); color: #ff8a7a; }
  .alert.ok { background: rgba(52,199,89,.1); border: 1px solid rgba(52,199,89,.3); color: #6fe08a; }
  .empty { text-align: center; padding: 56px 24px; color: var(--muted); }
  form.inline { display: inline; margin: 0; }
  .sticky-actions { display: flex; gap: 12px; align-items: center; margin-top: 28px; }
  /* Cover-image picker */
  .visually-hidden { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
  .image-picker { display: flex; gap: 16px; align-items: flex-start; }
  .image-preview { width: 200px; aspect-ratio: 16 / 9; flex: 0 0 auto; border-radius: 8px; border: 1px solid var(--border); background: #0e0e0e; overflow: hidden; display: flex; align-items: center; justify-content: center; }
  .image-preview img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .image-preview__empty { font-size: 12px; color: var(--muted); }
  .image-picker__controls { display: flex; flex-direction: column; gap: 8px; padding-top: 4px; }
  label.btn { width: max-content; }
</style>
