<!doctype html>
<html lang="en">

  <%- include('partials/_head') %>

  <body>
    <div id="root">
      <div class="min-h-screen flex flex-col bg-background">
        <%- include('partials/header') %>
        <main>
          <!-- Hero -->
          <section class="py-24 lg:py-32 bg-[#0A0A0A] border-b border-white/5">
            <div class="container max-w-4xl">
              <p class="text-[#E8523A] text-sm sm:text-base font-semibold tracking-wide uppercase mb-4"><%= page.eyebrow %></p>
              <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl text-white leading-[1.1] font-bold tracking-tight mb-6"><%= page.h1 %></h1>
              <p class="text-white/70 text-lg leading-relaxed max-w-3xl mb-8"><%= page.lede %></p>
              <div class="flex flex-wrap gap-5">
                <%- include('partials/_button', { label: 'Book a Free Strategy Call', href: site.externalLinks.bookACall, variant: 'primary', size: 'lg', external: true }) %>
                <%- include('partials/_button', { label: 'Cold Calling vs Direct Mail', href: '/cold-calling-vs-direct-mail', variant: 'outline', size: 'lg' }) %>
              </div>
            </div>
          </section>

          <!-- Intro -->
          <section class="py-20 lg:py-28 bg-[#0D0D0D] border-b border-white/5">
            <div class="container max-w-3xl space-y-6">
              <% page.intro.forEach(function(paragraph){ %>
              <p class="text-white/60 leading-relaxed text-lg"><%= paragraph %></p>
              <% }); %>
            </div>
          </section>

          <!-- How it works -->
          <section class="py-24 lg:py-32 bg-[#0A0A0A]">
            <div class="container">
              <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl text-white mb-14"><%= page.stepsHeading %></h2>
              <div class="grid md:grid-cols-2 gap-x-12 lg:gap-x-20 gap-y-10 max-w-5xl">
                <% page.steps.forEach(function(step){ %>
                <div class="flex items-start gap-5 border-l-2 border-[#E8523A]/40 pl-6">
                  <span class="font-display text-3xl text-[#E8523A]/60 shrink-0 leading-none"><%= step.number %></span>
                  <div>
                    <h3 class="text-lg font-semibold text-white mb-1.5"><%= step.title %></h3>
                    <p class="text-sm text-white/50 leading-relaxed"><%= step.body %></p>
                  </div>
                </div>
                <% }); %>
              </div>
            </div>
          </section>

          <!-- Benefits -->
          <section class="py-24 lg:py-32 bg-[#0D0D0D] border-y border-white/5">
            <div class="container">
              <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl text-white text-center mb-14"><%= page.benefitsHeading %></h2>
              <div class="grid md:grid-cols-3 gap-6 lg:gap-8 max-w-5xl mx-auto">
                <% page.benefits.forEach(function(b){ %>
                <div class="bg-[#141414] rounded-xl p-7 border border-white/5 hover:border-[#E8523A]/30 transition-all duration-300">
                  <h3 class="text-lg font-semibold text-white mb-2"><%= b.title %></h3>
                  <p class="text-sm text-white/60 leading-relaxed"><%= b.body %></p>
                </div>
                <% }); %>
              </div>
            </div>
          </section>

          <!-- CTA -->
          <section class="py-24 lg:py-32 bg-[#0A0A0A]">
            <div class="container max-w-3xl text-center">
              <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl text-white mb-5 leading-tight"><%= page.ctaHeading %></h2>
              <p class="text-white/60 leading-relaxed text-lg mb-8"><%= page.ctaSub %></p>
              <%- include('partials/_button', { label: 'Book a Call', href: site.externalLinks.bookACall, variant: 'primary', size: 'lg', external: true }) %>
            </div>
          </section>
        </main>
        <%- include('partials/footer') %>
      </div>
    </div>
    <div id="toast-region" class="lc-toaster" aria-live="polite" aria-atomic="false"></div>
  </body>

</html>
