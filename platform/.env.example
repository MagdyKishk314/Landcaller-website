# Landcaller platform service - environment template.
# Copy to .env and fill in. NEVER commit .env. Every value that existed in the
# old PHP code is considered compromised and must be a NEW/rotated credential.

# --- Service ---
PORT=3100
APP_ENV=development            # 'production' on the VPS
LOG_LEVEL=info

# --- MySQL / MariaDB (imported from the Hostinger dumps) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=landcaller_platform
DB_PASSWORD=
DB_NAME_GHL=landcaller_ghl     # import of u353253270_Landcaller_ghl
DB_NAME_LCDS=lcds_db           # import of u353253270_lcds_db (Phase 5)

# --- GoHighLevel / LeadConnector (marketplace app; rotate the client secret) ---
GHL_CLIENT_ID=
GHL_CLIENT_SECRET=
GHL_REDIRECT_URI=https://app.landcaller.com/callback.php
GHL_COMPANY_ID=                # agency companyId
GHL_MASTER_LOCATION_ID=        # the Landcaller master location
GHL_SNAPSHOT_ID=               # snapshot applied to new locations
# Shared secret we add to GHL workflow webhook URLs (?key=...) - new in the port;
# legacy endpoints accepted unauthenticated POSTs.
GHL_WEBHOOK_SHARED_SECRET=

# --- Stripe (two accounts; use RESTRICTED keys where possible) ---
STRIPE_SECRET_KEY_LC=          # "Land Caller" account (enterprise/CRM plans)
STRIPE_SECRET_KEY_LLC=         # "Land Caller LLC" account (Basic packages, Connect split)
STRIPE_WEBHOOK_SECRET_BRIDGE=      # signing secret for /stripe-webhook.php endpoint
STRIPE_WEBHOOK_SECRET_ENTERPRISE=  # signing secret for /stripe_products/enterprise_webhook.php
SIFTR_CONNECT_ACCOUNT_ID=      # acct_... destination for Basic revenue split

# --- Zoho Books (rotate; the old refresh token is in plaintext PHP) ---
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORGANIZATION_ID=

# --- Siftr partner API (rotate the bearer) ---
SIFTR_API_URL=https://console.siftr.net
SIFTR_BEARER_TOKEN=

# --- SSO into data.landcaller.com (generate a NEW keypair; give Siftr the public key) ---
SSO_PRIVATE_KEY_PATH=./keys/sso-private.pem
SSO_ISSUER=https://app.landcaller.com
SSO_AUDIENCE=siftr-landcaller
SSO_EXCHANGE_URL=https://data.landcaller.com/api/auth/landcaller/exchange
