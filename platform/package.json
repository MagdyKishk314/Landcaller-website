{
  "name": "landcaller-platform",
  "version": "0.1.0",
  "description": "Landcaller platform service (GHL provisioning, billing, LCDS) - Node port of the legacy PHP app served at app.landcaller.com",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.json",
    "dev": "npm run build && node --watch --env-file-if-exists=.env dist/server.js",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "npm run build && node --env-file-if-exists=.env dist/scripts/migrate.js",
    "test": "npm run build && node --test \"tests/*.test.js\""
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "mysql2": "^3.11.0",
    "stripe": "^17.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.5.4"
  }
}
