# Copy to .env and fill in. Required only for the /admin testimonials CMS.
# The public marketing site runs fine without any of these.

# Password for the /admin dashboard.
ADMIN_PASSWORD=change-me-to-something-strong

# Secret used to sign the admin session cookie. Use a long random string,
# e.g. the output of:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# Optional: origin of the legacy server that still hosts pages this site does
# not have. Unknown GET requests are 302-redirected there with the same path.
# Defaults to the old Hostinger box. Set to an empty value to serve a real 404.
# FALLBACK_ORIGIN=http://82.180.172.113

# Optional: where the SQLite database file lives.
# Defaults to ./data/blog.db locally (and /tmp/blog.db on Vercel). On a VPS,
# point this at a path on a persistent disk, e.g. /var/lib/landcaller/blog.db
# SQLITE_PATH=./data/blog.db
