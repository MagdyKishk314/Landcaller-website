{
  "name": "landcaller-clone",
  "version": "1.0.0",
  "description": "1:1 TypeScript MVC replica of landcaller.manus.space (Node.js + Express + EJS)",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build:server": "tsc -p tsconfig.json",
    "copy:views": "node scripts/copy-views.mjs",
    "build:client": "esbuild src/client/main.ts --bundle --minify --format=iife --outfile=public/assets/js/main.js",
    "build": "npm run clean && npm run build:server && npm run copy:views && npm run build:client",
    "dev:client": "esbuild src/client/main.ts --bundle --format=iife --sourcemap --outfile=public/assets/js/main.js --watch",
    "dev:server": "tsx watch src/server.ts",
    "dev": "npm run build:client && tsx watch src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test tests/smoke.test.js"
  },
  "dependencies": {
    "compression": "^1.7.4",
    "ejs": "^3.1.10",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.0",
    "esbuild": "^0.23.1",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
